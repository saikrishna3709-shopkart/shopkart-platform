region             = "us-east-1"
owner              = "YOUR-NAME"
kubernetes_version = "1.36"

# Replace with the public IPv4 address of the EC2 administration/Jenkins host.
# Keep /32 so only that host can reach the public EKS API endpoint.
api_allowed_cidrs = ["203.0.113.10/32"]

node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4

db_instance_class = "db.t4g.micro"