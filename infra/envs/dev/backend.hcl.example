# Copy to backend.hcl and set your own bucket name (bucket names are globally unique).
# Created by infra/bootstrap. Then:  terraform init -backend-config=backend.hcl

bucket         = "shopkart-tfstate-CHANGE-ME"
key            = "dev/terraform.tfstate"
region         = "us-east-1"
encrypt        = true
dynamodb_table = "shopkart-tfstate-lock"
